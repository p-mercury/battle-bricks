{
	"name": "@battle-bricks/policy-service",
	"private": true,
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./dist/*": "./dist/*.js",
		"./permissions": "./dist/permissions.ts",
		"./policy": "./dist/policy.wasm"
	},
	"scripts": {
		"build": "mkdir -p dist && opa build -b rego -o dist/bundle.tar.gz && opa build -b rego -o dist/wasm.tar.gz -e / -t wasm && tar xzf dist/wasm.tar.gz -C dist /policy.wasm && tsc",
		"install": "go mod download",
		"lint": "opa check -b rego -s ../../../../packages/contracts/dist/json-schema && tsc"
	},
	"dependencies": {
		"@aws-cdk/aws-lambda-go-alpha": "^2.264.0-alpha.0",
		"@battle-bricks/backbone": "workspace:*",
		"@battle-bricks/contracts": "workspace:*",
		"@bufbuild/buf": "^1.72.0",
		"@bufbuild/protobuf": "^2.13.0",
		"@bufbuild/protoc-gen-es": "^2.13.0",
		"@connectrpc/connect": "^2.1.2",
		"@types/node": "^26.2.0",
		"aws-cdk-lib": "^2.264.0",
		"constructs": "^10.8.1",
		"typescript": "^6.0.3"
	}
}
