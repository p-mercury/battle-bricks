{
	"name": "@battle-bricks/contracts",
	"private": true,
	"type": "module",
	"exports": {
		"./*": {
			"types": "./dist/*.d.ts",
			"default": "./dist/*.js"
		},
		"./permissions": {
			"types": "./dist/permissions.d.ts",
			"default": "./dist/permissions.js"
		}
	},
	"scripts": {
		"build": "rm -rf dist && [ -n \"$(go env GOBIN)\" ] && export PATH=\"$(go env GOBIN):${PATH}\"; [ -n \"$(go env GOPATH)\" ] && export PATH=\"$(go env GOPATH)/bin:${PATH}\"; pnpm exec buf generate && tsc",
		"install": "go mod download",
		"lint": "pnpm exec buf lint"
	},
	"dependencies": {
		"@battle-bricks/protoc-gen-event-registry": "workspace:*",
		"@bufbuild/buf": "^1.72.0",
		"@bufbuild/protobuf": "^2.14.0",
		"@bufbuild/protoc-gen-es": "^2.14.0",
		"aws-cdk-lib": "^2.265.0",
		"constructs": "^10.8.1",
		"typescript": "^7.0.2"
	}
}
